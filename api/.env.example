# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/payverify"

# ── App ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SMS_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ADMIN_SECRET=REPLACE_WITH_ADMIN_SECRET

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── Africa's Talking (SMS Gateway) ───────────────────────────────
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key
AT_SHORTCODE=your_shortcode_or_phone_number

# ── TeleBirr Payment (Ethio Telecom Developer Portal) ───────────
# Credentials from: https://developer.ethiotelecom.et
TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_FABRIC_APP_ID=your_fabric_app_id
TELEBIRR_APP_SECRET=your_app_secret
TELEBIRR_MERCHANT_APP_ID=your_merchant_app_id
TELEBIRR_MERCHANT_CODE=your_merchant_code
TELEBIRR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
TELEBIRR_NOTIFY_URL=https://api.payverify.et/v1/telebirr/notify
